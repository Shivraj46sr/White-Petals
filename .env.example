# Copy this file to .env and replace the placeholders before enabling login.
APP_PASSWORD=
SECRET_KEY=

# Scheduled report time in Asia/Kolkata (24-hour clock).
DAILY_REPORT_HOUR=18
DAILY_REPORT_MINUTE=0
DAILY_BACKUP_HOUR=2
DAILY_BACKUP_MINUTE=15

# Keep local unless you have secured the deployment (HTTPS, auth, firewall).
HOST=127.0.0.1
PORT=5000

# Optional Google Gemini API configuration. Store the real key only in local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local Ollama. Set a model name to enable; the endpoint must be loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
